# Normalize line endings for the repo: LF in the index and on disk.
# Netlify and GitHub Pages serve from Linux, so LF is the right default.

* text=auto eol=lf

# Common text formats
*.astro    text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.js       text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.mjs      text eol=lf
*.svg      text eol=lf
*.toml     text eol=lf
*.ts       text eol=lf
*.txt      text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
.gitignore text eol=lf

# Binary assets (no normalization, no diff noise)
*.gif  binary
*.ico  binary
*.jpeg binary
*.jpg  binary
*.JPG  binary
*.mp4  binary
*.pdf  binary
*.png  binary
*.webm binary
*.webp binary
*.woff binary
*.woff2 binary
