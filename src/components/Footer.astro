---
import SlackCTA from './SlackCTA.astro';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-content">
    <div class="footer-brand">
      <p class="footer-brand-name">OK Studio</p>
      <p class="footer-tagline">// Tools for accessibility</p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <a href="/#projects">Projects</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
    </nav>

    <div class="footer-social">
      <SlackCTA variant="inline" />
      <a href="https://github.com/okstudio1" target="_blank" rel="noopener noreferrer" aria-label="GitHub">GitHub</a>
      <a href="https://www.linkedin.com/in/owenpkent/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">LinkedIn</a>
    </div>
  </div>

  <p class="footer-copyright">&copy; {year} OK Studio Inc. All rights reserved.</p>
</footer>

<style>
  .footer {
    margin-top: 4rem;
    padding: 3rem 0 1.5rem;
    background: var(--bg-secondary);
    color: var(--text-muted);
    position: relative;
  }
  .footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--gradient-cyber);
  }
  .footer-content {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
    text-align: center;
  }
  .footer-brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--text);
    margin: 0;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }
  .footer-tagline {
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
    font-family: var(--font-display);
    color: var(--neon-cyan);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .footer-nav,
  .footer-social {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .footer-nav a,
  .footer-social a {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
    font-family: var(--font-display);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: all var(--transition);
  }
  .footer-nav a:hover,
  .footer-social a:hover {
    color: var(--neon-cyan);
    text-shadow: 0 0 10px var(--accent-glow);
  }

  .footer-copyright {
    text-align: center;
    margin: 2rem 0 0;
    font-size: 0.8rem;
    color: var(--text-dim);
    font-family: var(--font-display);
    letter-spacing: 0.05em;
  }

  @media (min-width: 720px) {
    .footer-content {
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      text-align: left;
    }
    .footer-social { justify-content: flex-end; }
  }
</style>
