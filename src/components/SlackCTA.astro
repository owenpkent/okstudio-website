---
import { siteConfig } from '../config/site';

interface Props {
  variant?: 'inline' | 'block';
}

const { variant = 'inline' } = Astro.props;
---

{variant === 'block' ? (
  <a
    href={siteConfig.slackInviteUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="slack-block"
    data-track="slack_clicked"
  >
    <span class="slack-block__icon" aria-hidden="true">▣</span>
    <span class="slack-block__copy">
      <span class="slack-block__title">Join the Slack workspace</span>
      <span class="slack-block__sub">Talk to other users, share builds, request features.</span>
    </span>
    <span class="slack-block__arrow" aria-hidden="true">→</span>
  </a>
) : (
  <a
    href={siteConfig.slackInviteUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="slack-inline"
    data-track="slack_clicked"
  >
    <span aria-hidden="true">▣</span> Slack
  </a>
)}

<style>
  .slack-block {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    color: var(--text);
    text-decoration: none;
    transition: all var(--transition);
    backdrop-filter: blur(10px);
  }
  .slack-block:hover {
    border-color: var(--neon-cyan);
    transform: translateY(-2px);
    box-shadow: 0 0 30px rgba(0, 240, 255, 0.15);
    color: var(--text);
  }
  .slack-block__icon {
    font-size: 1.5rem;
    color: var(--neon-cyan);
    text-shadow: 0 0 10px var(--accent-glow);
  }
  .slack-block__copy { flex: 1; display: flex; flex-direction: column; gap: 0.2rem; }
  .slack-block__title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.95rem;
  }
  .slack-block__sub { color: var(--text-muted); font-size: 0.9rem; line-height: 1.5; }
  .slack-block__arrow { color: var(--neon-cyan); font-size: 1.25rem; }

  .slack-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
    text-decoration: none;
    transition: all var(--transition);
  }
  .slack-inline:hover {
    color: var(--neon-cyan);
    text-shadow: 0 0 10px var(--accent-glow);
  }
  .slack-inline span[aria-hidden] { color: var(--neon-cyan); }
</style>
