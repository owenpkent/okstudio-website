---
import Base from '../layouts/Base.astro';
import SlackCTA from '../components/SlackCTA.astro';
import NewsletterInline from '../components/NewsletterInline.astro';
---

<Base
  title="Thanks, OK Studio"
  description="Thanks for reaching out. I'll be in touch soon."
  noindex={true}
>
  <section class="thanks">
    <div class="container thanks__inner">
      <div class="thanks__icon" aria-hidden="true">✓</div>
      <h1 class="page-title">Message received.</h1>
      <p class="lede">
        Thanks for reaching out. I read every message and will get back to you
        within a few days.
      </p>

      <div class="next-steps">
        <h2>// While you're here</h2>
        <div class="next-steps__grid">
          <a href="/#projects" class="next-card">
            <h3>Browse the projects</h3>
            <p>Three products in flight: Alpha-OSK shipping, MacroVox and Nimbus coming soon.</p>
          </a>
          <a href="https://github.com/okstudio1" class="next-card" target="_blank" rel="noopener noreferrer">
            <h3>Star us on GitHub</h3>
            <p>Most of the studio's tools are open source. Stars help discoverability.</p>
          </a>
        </div>
      </div>

      <div class="thanks__slack">
        <SlackCTA variant="block" />
      </div>

      <div class="thanks__newsletter">
        <NewsletterInline variant="card" heading="Stay in touch by email." body="Weekly updates on what shipped and what's coming." />
      </div>

      <a href="/" class="back-home">← Back to the homepage</a>
    </div>
  </section>
</Base>

<style>
  .thanks {
    padding: 140px 0 4rem;
    min-height: 60vh;
    position: relative;
    overflow: hidden;
  }
  .thanks::before {
    content: '';
    position: absolute;
    top: 10%;
    left: 50%;
    transform: translateX(-50%);
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 255, 136, 0.12) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
  }
  .thanks__inner {
    max-width: 720px;
    text-align: center;
    position: relative;
  }
  .thanks__icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 1.5rem;
    border-radius: 50%;
    background: var(--gradient-cyber);
    color: #000;
    display: grid;
    place-items: center;
    font-size: 2.5rem;
    font-weight: 700;
    box-shadow: 0 0 40px var(--accent-glow);
  }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 1rem;
    color: var(--text);
    letter-spacing: -0.03em;
  }
  .lede {
    color: var(--text-muted);
    font-size: 1.15rem;
    margin: 0 auto 3rem;
    max-width: 560px;
    line-height: 1.65;
  }
  .next-steps h2 {
    font-family: var(--font-display);
    font-size: 0.95rem;
    margin: 0 0 1.5rem;
    color: var(--neon-magenta);
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }
  .next-steps__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    margin-bottom: 3rem;
  }
  @media (min-width: 600px) {
    .next-steps__grid { grid-template-columns: 1fr 1fr; }
  }
  .next-card {
    padding: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    color: var(--text);
    text-decoration: none;
    text-align: left;
    transition: all var(--transition);
    backdrop-filter: blur(10px);
  }
  .next-card:hover {
    border-color: var(--neon-cyan);
    transform: translateY(-2px);
    box-shadow: 0 0 30px rgba(0, 240, 255, 0.15);
    color: var(--text);
  }
  .next-card h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    margin: 0 0 0.5rem;
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .next-card p { color: var(--text-muted); margin: 0; font-size: 0.9rem; line-height: 1.6; }

  .thanks__slack { margin: 0 auto 2rem; max-width: 520px; text-align: left; }
  .thanks__newsletter { margin: 0 auto 3rem; max-width: 520px; text-align: left; }

  .back-home {
    display: inline-block;
    color: var(--neon-cyan);
    font-family: var(--font-display);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
  }
  .back-home:hover {
    color: var(--neon-magenta);
    text-shadow: 0 0 10px rgba(255, 0, 170, 0.5);
  }
</style>
