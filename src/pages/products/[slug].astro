---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import NewsletterInline from '../../components/NewsletterInline.astro';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product, all: products },
  }));
}

const { product, all } = Astro.props;
const { Content } = await render(product);
const data = product.data;

const related = data.related
  .map((id) => all.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const statusLabel: Record<string, string> = {
  live: 'Live',
  'coming-soon': 'Coming Soon',
  active: 'Active',
  planning: 'In Development',
};

const description = `${data.tagline} ${data.title} from OK Studio.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: data.title,
  description: data.tagline,
  applicationCategory: data.category,
  operatingSystem: data.tags.includes('Linux') ? 'Windows, Linux' : 'Windows',
  offers: {
    '@type': 'Offer',
    price: data.pricing.toLowerCase().includes('free') ? '0' : undefined,
    priceCurrency: 'USD',
    description: data.pricing,
  },
  url: `https://okstud.io/products/${product.id}/`,
  ...(data.repo ? { sameAs: data.repo } : {}),
  author: {
    '@type': 'Organization',
    name: 'OK Studio',
    url: 'https://okstud.io',
  },
};
---

<Base title={`${data.title} | OK Studio`} description={description} jsonLd={jsonLd}>
  <article>
    <header class="product-hero">
      <div class="container product-hero__inner">
        <a href="/#projects" class="back-link">← All projects</a>

        <div class="product-hero__head">
          <span class="product-hero__icon" aria-hidden="true">{data.icon}</span>
          <span class={`product-hero__status status--${data.status}`}>{statusLabel[data.status]}</span>
        </div>

        <h1 class="product-hero__title">{data.title}</h1>
        <p class="product-hero__tagline">{data.tagline}</p>

        <div class="product-hero__meta">
          <span class="meta-chip">{data.category}</span>
          <span class="meta-chip meta-chip--pricing">{data.pricing}</span>
        </div>

        <div class="product-hero__cta">
          {data.downloadUrl && (
            <a
              href={data.downloadUrl}
              class="btn btn-primary"
              target={data.downloadUrl.startsWith('#') ? undefined : '_blank'}
              rel={data.downloadUrl.startsWith('#') ? undefined : 'noopener noreferrer'}
              data-track={data.status === 'coming-soon' ? 'notify_clicked' : 'download_clicked'}
              data-product={product.id}
            >
              {data.downloadLabel}
            </a>
          )}
          {data.repo && (
            <a
              href={data.repo}
              class="btn btn-secondary"
              target="_blank"
              rel="noopener noreferrer"
            >
              View on GitHub
            </a>
          )}
        </div>

        {data.pricingNote && <p class="product-hero__note">{data.pricingNote}</p>}
      </div>
    </header>

    {data.media.length > 0 && (
      <section class="media" aria-labelledby="media-title">
        <div class="container">
          <h2 id="media-title" class="section-title">See it in action</h2>
          <div class="media__grid">
            {data.media.map((item) => (
              <figure class={`media__item media__item--${item.type}`}>
                {item.placeholder ? (
                  <div class="media__placeholder" role="img" aria-label={item.alt}>
                    <span class="media__placeholder-tag">
                      {item.type === 'gif' ? 'GIF' : item.type === 'video' ? 'VIDEO' : 'SCREENSHOT'}
                    </span>
                    <span class="media__placeholder-alt">{item.alt}</span>
                  </div>
                ) : item.type === 'video' ? (
                  <video src={item.src} controls preload="metadata" aria-label={item.alt} />
                ) : (
                  <img src={item.src} alt={item.alt} loading="lazy" />
                )}
                {item.caption && <figcaption>{item.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    {data.whatsNew && (
      <section class="whats-new" aria-labelledby="whats-new-title">
        <div class="container whats-new__inner">
          <header class="whats-new__head">
            <span class="whats-new__badge">v{data.whatsNew.version}</span>
            <h2 id="whats-new-title" class="section-title">What's new</h2>
            <span class="whats-new__date">Released {data.whatsNew.date}</span>
          </header>
          <ul class="whats-new__list">
            {data.whatsNew.highlights.map((h) => <li>{h}</li>)}
          </ul>
        </div>
      </section>
    )}

    <section class="product-body">
      <div class="container product-body__inner">
        <div class="prose">
          <Content />
        </div>

        {data.audience && (
          <aside class="audience-card">
            <h2>Who it's for</h2>
            <p>{data.audience}</p>
          </aside>
        )}
      </div>
    </section>

    {data.installSnippets.length > 0 && (
      <section class="install" aria-labelledby="install-title">
        <div class="container install__inner">
          <h2 id="install-title" class="section-title">How to install</h2>
          <div class="install__tabs">
            {data.installSnippets.map((snippet, idx) => (
              <details class="install__tab" open={idx === 0}>
                <summary>{snippet.label}</summary>
                <pre class={`language-${snippet.lang}`}><code>{snippet.code.trim()}</code></pre>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <div id="newsletter" class="container newsletter-wrap">
      <NewsletterInline
        variant="strip"
        heading={data.status === 'coming-soon' ? `Get notified when ${data.title} ships.` : `Get updates on ${data.title}.`}
        body="One email per week. What shipped, what's next, what I'm learning. No spam."
      />
    </div>

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <div class="container">
          <h2 id="related-title" class="related__title">Related products</h2>
          <div class="related__grid">
            {related.map((p) => <ProductCard product={p} variant="secondary" />)}
          </div>
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .product-hero {
    padding: 140px 0 4rem;
    color: var(--text);
    position: relative;
    overflow: hidden;
  }
  .product-hero::before {
    content: '';
    position: absolute;
    top: 5%;
    left: -15%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 240, 255, 0.12) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
  }
  .product-hero::after {
    content: '';
    position: absolute;
    bottom: -10%;
    right: -15%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(255, 0, 170, 0.1) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
  }
  .product-hero__inner { position: relative; max-width: 820px; }

  .back-link {
    display: inline-block;
    color: var(--neon-cyan);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 1.75rem;
  }
  .back-link:hover {
    color: var(--neon-magenta);
    text-shadow: 0 0 10px rgba(255, 0, 170, 0.5);
  }

  .product-hero__head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .product-hero__icon {
    width: 64px;
    height: 64px;
    background: rgba(0, 240, 255, 0.1);
    border: 1px solid var(--border);
    border-radius: 12px;
    display: grid;
    place-items: center;
    font-size: 2rem;
    color: var(--neon-cyan);
    box-shadow: 0 0 20px var(--accent-glow);
  }
  .product-hero__status {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    padding: 6px 14px;
    border-radius: 3px;
    border: 1px solid currentColor;
  }
  .status--live { color: var(--neon-green); background: rgba(0, 255, 136, 0.08); }
  .status--coming-soon { color: var(--neon-magenta); background: rgba(255, 0, 170, 0.08); }
  .status--active { color: var(--neon-cyan); background: rgba(0, 240, 255, 0.08); }
  .status--planning { color: var(--neon-yellow); background: rgba(240, 255, 0, 0.08); }

  .product-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin: 0 0 0.75rem;
    color: var(--text);
    letter-spacing: -0.03em;
    background: var(--gradient-cyber);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    filter: drop-shadow(0 0 30px var(--accent-glow));
  }
  .product-hero__tagline {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    color: var(--text-muted);
    margin: 0 0 1.75rem;
    line-height: 1.6;
  }

  .product-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .meta-chip {
    font-family: var(--font-display);
    padding: 5px 12px;
    background: rgba(0, 240, 255, 0.08);
    border: 1px solid rgba(0, 240, 255, 0.3);
    border-radius: 3px;
    font-size: 0.75rem;
    color: var(--neon-cyan);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .meta-chip--pricing {
    background: rgba(170, 0, 255, 0.08);
    border-color: rgba(170, 0, 255, 0.3);
    color: var(--neon-purple);
  }

  .product-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .product-hero__note {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--text-dim);
    font-style: italic;
  }

  .product-body { padding: 4rem 0 2rem; }
  .product-body__inner {
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .product-body__inner {
      grid-template-columns: minmax(0, 2fr) 1fr;
      align-items: start;
    }
  }

  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: 1.75rem;
    margin: 2.5rem 0 1rem;
    color: var(--text);
    letter-spacing: -0.02em;
    position: relative;
    padding-left: 1rem;
  }
  .prose :global(h2)::before {
    content: '//';
    position: absolute;
    left: 0;
    color: var(--neon-cyan);
    font-weight: 400;
  }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p) { color: var(--text-muted); line-height: 1.75; }
  .prose :global(ul) { color: var(--text-muted); line-height: 1.75; padding-left: 1.25rem; list-style: none; }
  .prose :global(li) {
    margin-bottom: 0.6rem;
    position: relative;
    padding-left: 1.25rem;
  }
  .prose :global(li)::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--neon-cyan);
  }
  .prose :global(li strong) { color: var(--text); }
  .prose :global(a) { color: var(--neon-cyan); }
  .prose :global(a):hover { color: var(--neon-magenta); text-shadow: 0 0 10px rgba(255, 0, 170, 0.5); }
  .prose :global(code) {
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    padding: 2px 6px;
    border-radius: 3px;
    font-family: var(--font-display);
    font-size: 0.85em;
    color: var(--neon-cyan);
  }

  .audience-card {
    padding: 1.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    position: sticky;
    top: 100px;
    backdrop-filter: blur(10px);
  }
  .audience-card h2 {
    font-family: var(--font-display);
    font-size: 0.95rem;
    margin: 0 0 0.75rem;
    color: var(--neon-magenta);
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }
  .audience-card p { margin: 0; color: var(--text-muted); line-height: 1.7; }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    margin: 0 0 2rem;
    color: var(--text);
    letter-spacing: -0.02em;
    text-align: center;
  }

  .media { padding: 4rem 0 1rem; }
  .media__grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
  }
  .media__item {
    margin: 0;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all var(--transition);
  }
  .media__item:hover {
    border-color: var(--neon-cyan);
    box-shadow: 0 0 30px rgba(0, 240, 255, 0.15);
  }
  .media__item img,
  .media__item video {
    width: 100%;
    height: auto;
    display: block;
    background: var(--bg-tertiary);
  }
  .media__item figcaption {
    padding: 0.85rem 1rem;
    color: var(--text-muted);
    font-size: 0.85rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-display);
  }

  .media__placeholder {
    aspect-ratio: 16 / 10;
    background:
      repeating-linear-gradient(45deg, rgba(0, 240, 255, 0.04) 0 12px, transparent 12px 24px),
      linear-gradient(135deg, rgba(0, 240, 255, 0.05), rgba(255, 0, 170, 0.05));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.5rem;
    text-align: center;
    border: 2px dashed var(--border-strong);
  }
  .media__placeholder-tag {
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    padding: 5px 14px;
    border-radius: 3px;
    background: rgba(0, 0, 0, 0.4);
    color: var(--neon-cyan);
    border: 1px solid var(--neon-cyan);
    box-shadow: 0 0 10px var(--accent-glow);
  }
  .media__placeholder-alt {
    color: var(--text-muted);
    font-size: 0.85rem;
    max-width: 280px;
    line-height: 1.5;
  }

  .whats-new { padding: 3rem 0 1rem; }
  .whats-new__inner { max-width: 720px; }
  .whats-new__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .whats-new__head .section-title { margin: 0; }
  .whats-new__badge {
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    padding: 5px 14px;
    background: var(--gradient-cyber);
    color: #000;
    border-radius: 3px;
    box-shadow: 0 0 20px var(--accent-glow);
    font-weight: 600;
  }
  .whats-new__date {
    color: var(--text-dim);
    font-size: 0.85rem;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }
  .whats-new__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .whats-new__list li {
    padding: 1rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--neon-cyan);
    border-radius: var(--radius);
    color: var(--text-muted);
    line-height: 1.6;
    transition: all var(--transition);
  }
  .whats-new__list li:hover {
    border-color: var(--neon-cyan);
    border-left-color: var(--neon-cyan);
    box-shadow: 0 0 20px rgba(0, 240, 255, 0.1);
  }

  .install { padding: 3rem 0 1rem; }
  .install__inner { max-width: 820px; }
  .install__tabs { display: flex; flex-direction: column; gap: 0.75rem; }
  .install__tab {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .install__tab summary {
    padding: 1rem 1.25rem;
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--text);
    cursor: pointer;
    user-select: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.9rem;
  }
  .install__tab summary:hover { background: var(--bg-tertiary); color: var(--neon-cyan); }
  .install__tab[open] summary { border-bottom: 1px solid var(--border); }
  .install__tab pre {
    margin: 0;
    padding: 1.5rem;
    background: #0a0a14;
    color: #c8d4e8;
    overflow-x: auto;
    font-family: var(--font-display);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .newsletter-wrap { margin-top: 2rem; }

  .related { padding: 3rem 0 4rem; }
  .related__title {
    font-family: var(--font-display);
    font-size: 1.75rem;
    margin: 0 0 2rem;
    text-align: center;
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .related__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
</style>
